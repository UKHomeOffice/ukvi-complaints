# Local development runner configuration.
# Copy this file to .local-service.env only if you need to override these values locally.
# Do not put secret values in this file.

SERVICE_NAME=ukvi-complaints

SECRETS_REPO_NAME=hof-services-secrets
SECRETS_REPO_URL=keybase://team/hoforms/hof-services-secrets
SECRETS_SYNC_TIMEOUT_SECONDS=20
APP_SECRETS_FILE_NAME=UKVIC-env
SIDECAR_SECRETS_FILE_NAME=file-vault-env

ROOT_ENV=.env
COMPOSE_ENV=.devcontainer/devcontainer.env
COMPOSE_FILE=.devcontainer/docker-compose.dev.yml
DEPENDENCY_SERVICES="redis postgres rds-api file-vault sqs-mock"

INSTALL_COMMAND="yarn install"
START_COMMAND="yarn start:dev"

REQUIRED_ENV_KEYS="NODE_ENV SESSION_SECRET FILE_VAULT_URL DATASERVICE_USE_HTTPS DATASERVICE_SERVICE_HOST DATASERVICE_SERVICE_PORT_HTTPS KEYCLOAK_TOKEN_URL KEYCLOAK_USERNAME KEYCLOAK_PASSWORD KEYCLOAK_CLIENT_ID KEYCLOAK_SECRET AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION AWS_BUCKET AWS_PASSWORD NOTIFY_TEMPLATE CASEWORKER_EMAIL CSV_REPORT_TEMPLATE_ID CSV_REPORT_EMAIL SEND_TO_DECS_QUEUE SQS_URL"
LOCAL_ENV_OVERRIDES="NODE_ENV=development REDIS_HOST=127.0.0.1 REDIS_PORT=6379 FILE_VAULT_URL=http://localhost:3000/file DATASERVICE_USE_HTTPS=false DATASERVICE_SERVICE_HOST=127.0.0.1 DATASERVICE_SERVICE_PORT_HTTPS=5000 SEND_TO_DECS_QUEUE=offline SQS_URL=http://localhost:9324/queue/first-queue AWS_REGION=eu-west-2"

GENERATE_SESSION_SECRET=true
APP_PORT_ENV_KEY=PORT
DEFAULT_APP_PORT=8080
STOP_STALE_NODE_APP=true
RECREATE_DEPENDENCIES=true
KEYBASE_BIN=/Applications/Keybase.app/Contents/SharedSupport/bin