{
  "name": "ukvi-complaints",
  "version": "1.0.0",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "description": "",
  "engines": {
    "node": ">=24.21.0 <25.0.0"
  },
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "start:dev": "[ -f .env ] && hof-build watch --env || hof-build watch",
    "test": "yarn run test:lint && yarn run test:unit",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "nyc _mocha \"test/_unit/**/*.spec.js\"",
    "test:acceptance": "TAGS=\"${TAGS:=@feature}\" npm run test:cucumber",
    "test:acceptance_browser": "ACCEPTANCE_WITH_BROWSER=true TAGS=\"${TAGS:=@feature}\" yarn run test:cucumber",
    "test:cucumber": "cucumber-js -f pretty \"test/_features/**/*.feature\" --require test/_features/test.setup.js --require \"test/_features/step_definitions/**/*.js\" --tags $TAGS",
    "test:cucumber-name": "cucumber-js -f pretty \"test/_features/**/*.feature\" --require test/_features/test.setup.js --require \"test/_features/step_definitions/**/*.js\" --name $NAME",
    "sqs-setup": "docker build -q -t sqs-mock test/_integration/sqs-mock && docker run --name sqs-mock -p 9324:9324 -d sqs-mock",
    "sqs-cleanup": "docker stop sqs-mock && docker container rm sqs-mock",
    "build": "hof-build",
    "postinstall": "yarn run build",
    "generate:reports": "node ./services/reports/generate_reports.js",
    "generate:local:reports": "node -r dotenv/config ./services/reports/generate_reports.js"
  },
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "bl": "^6.1.6",
    "busboy": "^1.6.0",
    "form-data": "^4.0.6",
    "hof": "~24.5.0",
    "hot-shots": "^11.4.0",
    "jsonschema": "^1.5.0",
    "moment": "^2.30.1",
    "sqs-producer": "^9.0.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "playwright": "^1.63.0",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1"
  },
  "mocha": {
    "reporter": "spec",
    "require": "test/setup.js",
    "recursive": "true",
    "timeout": "6000"
  },
  "resolutions": {
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.7",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.2",
    "morgan": "^1.12.0",
    "nanoid": "^5.1.16",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.7",
    "tar": "^7.5.21",
    "undici": "^8.9.0",
    "diff": "^8.0.3"
  }
}
